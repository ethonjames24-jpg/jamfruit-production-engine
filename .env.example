# JamFruit Stories — A01 Safe Mode baseline
# Copy to .env only on an approved host. Do not commit the resulting .env file.

NODE_ENV=production
PORT=3456
LOG_LEVEL=info

# A01 hard safety controls. These values MUST remain as shown for the pilot foundation.
JAMFRUIT_SAFE_MODE=true
ENABLE_INTERNAL_SCHEDULER=false
ENABLE_YOUTUBE_PUBLISHING=false
ENABLE_AI_GENERATION=false
ENABLE_DATABASE_WRITES=false

# Protected API credential. Leave unset during A01 Safe Mode because only /health and /ready are exposed.
# When a later approved phase exposes protected routes, this must be supplied as a secret at runtime.
API_KEY=

# Provider credentials are intentionally unset in A01.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# REPLICATE_API_KEY=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=

# FFmpeg may be configured in a later approved media-production phase.
# FFMPEG_PATH=
